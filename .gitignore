# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

/dist/
**/dist/
/.wrangler/
/outputs/*
!/outputs/kiln-build-handoff.md
!/outputs/kiln-product-requirements-document.md
!/outputs/kiln-workbench.png
!/outputs/kiln-workbench-mobile.png
/work/
/.playwright-cli/
/output/

# Python and local execution
/.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Kiln-generated runtime data
/.kiln/
/artifacts/
/sandbox-workspaces/
*.sqlite
*.sqlite3
*.db
**/test.db
**/*.tsbuildinfo
