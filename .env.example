# Browser-exposed variables must never contain secrets.

# Server-only connection to the Python orchestrator.
KILN_ORCHESTRATOR_URL=http://127.0.0.1:8100
KILN_SERVICE_TOKEN=replace-with-a-long-random-service-token
KILN_EXECUTOR_SERVICE_TOKEN=replace-with-a-separate-long-random-token
KILN_PLANNER_MODE=auto
KILN_OPENAI_MODEL=gpt-5.6-terra
OPENAI_API_KEY=

# Public preview host suffix. Generated applications must not share Kiln's origin.
KILN_PREVIEW_HOST=preview.localhost
