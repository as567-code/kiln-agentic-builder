{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/dispatch.mjs": {
      "maxDuration": 300
    },
    "api/proxy.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/executor/dispatch",
      "destination": "/api/dispatch"
    },
    {
      "source": "/",
      "destination": "/api/proxy?kiln_path="
    },
    {
      "source": "/:rest*",
      "destination": "/api/proxy?kiln_path=:rest*"
    }
  ]
}
